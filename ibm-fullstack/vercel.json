{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/**/*.js": {
      "maxDuration": 30
    }
  },
  "env": {
    "NEXT_PUBLIC_DISABLE_SOCKETIO": "true"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_DISABLE_SOCKETIO": "true"
    }
  }
}
